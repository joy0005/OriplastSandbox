    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Ori_Plast_Order__c.Edit_Order</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.Order_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Delete</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Order_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Delivered</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Order_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Submitted</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Order_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Partially Delivered</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Ori_Plast_Order__c.Generate_Sales_Order</value>
                            <visibilityRule>
                                <booleanFilter>1 OR 2 OR 3</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Order_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Submitted</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Order_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Order_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Received by Navision</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Ori_Plast_Order__c.Submit_Order</value>
                            <visibilityRule>
                                <booleanFilter>1 AND (2 OR 3)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Order_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Distributor</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Management</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                    </valueList>
