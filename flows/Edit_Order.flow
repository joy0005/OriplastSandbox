    <decisions>
        <name>Select_Create_Edit_or_Delete</name>
        <label>Select Create,Edit or Delete</label>
        <locationX>1579</locationX>
        <locationY>890</locationY>
        <defaultConnector>
            <targetReference>Delete_Order_Line_Item</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If Delete</defaultConnectorLabel>
        <rules>
            <name>if_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CreateOrderLineItems</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetPicklistValuesinVar</targetReference>
            </connector>
            <label>if Create</label>
        </rules>
        <rules>
            <name>If_Edit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Edit_Order_Line_Items</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_for_assign_product_category_E</targetReference>
            </connector>
            <label>If Edit</label>
        </rules>
    </decisions>
    <description>last activated version -24. now if any item is already present on the same order then user cannot re add the same product. on create record if rhe selected product is present on pending list it will show all the details  and quantity will come pending quantity . also box order quantity added on create line item .</description>
    <environments>Default</environments>
    <formulas>
        <name>CalculateGST</name>
        <dataType>Currency</dataType>
        <expression>{!FinalPriceAfterAllDiscount}+({!FinalPriceAfterAllDiscount}*({!Loop.GST_Value__c}/100))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculateGST_E</name>
        <dataType>Currency</dataType>
        <expression>{!FinalPriceAfterAllDiscount}+({!FinalPriceAfterAllDiscount}*({!For_Each_Item_Of_Select.Ori_Plast_Product__r.GST_Value__c}/100))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>calculateQuantityForBoxOrder</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Box_Order_Quantity}), 0, VALUE({!No_Of_Pcs_in_One_Box}) * VALUE({!Box_Order_Quantity}))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>checkboxTrueForBoxOrder</name>
        <dataType>Boolean</dataType>
        <expression>{!NoOfPcsInOneBox} &gt; 0</expression>
    </formulas>
    <formulas>
        <name>checkQuantityUnit</name>
        <dataType>Boolean</dataType>
        <expression>IF(MOD({!Order_Quantity_For_Create},(VALUE({!Loop.Length__c})/100))=0, True, False)</expression>
    </formulas>
    <formulas>
        <name>checkQuantityUnitForEdit</name>
        <dataType>Boolean</dataType>
        <expression>IF(MOD({!Quantity},(VALUE({!For_Each_Item_Of_Select.Ori_Plast_Product__r.Length__c})/100))=0, True, False)</expression>
    </formulas>
    <formulas>
        <name>CheckQuantityValue</name>
        <dataType>Boolean</dataType>
        <expression>REGEX(Text({!Order_Quantity_For_Create}), &quot;^[0-9]+$&quot;)</expression>
    </formulas>
    <formulas>
        <name>CheckQuantityValueForEdit</name>
        <dataType>Boolean</dataType>
        <expression>REGEX(Text({!Quantity}), &quot;^[0-9]+$&quot;)</expression>
    </formulas>
    <formulas>
        <name>FormulaForBoxOrderQtyNumber</name>
        <dataType>Number</dataType>
        <expression>IF(
    ISBLANK({!Box_Order_Quantity}),
    0,
    VALUE({!Box_Order_Quantity})
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>FormulaForBoxOrderQuantityRequired</name>
        <dataType>Boolean</dataType>
        <expression>IF(VALUE({!Box_Order_Quantity}) &gt; 0, true, false)</expression>
    </formulas>
    <formulas>
        <name>FormulaForCashDiscount</name>
        <dataType>Currency</dataType>
        <expression>{!ProductPriceAfterTradeDiscount}*(IF(NOT(ISBLANK({!Get_Discount.Id})), {!Get_Discount.Cash_Discount__c}, 0)/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForCashDiscount_E</name>
        <dataType>Currency</dataType>
        <expression>{!ProductPriceAfterTradeDiscount}*(IF(NOT(ISBLANK({!Get_Discount_E.Id})), {!Get_Discount_E.Cash_Discount__c}, 0)/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForCGST</name>
        <dataType>Currency</dataType>
        <expression>{!TotalGST}/2</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForCGST_E</name>
        <dataType>Currency</dataType>
        <expression>{!TotalGST}/2</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForCreateOrderQuantity</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Order_Quantity_For_Create} &gt; 0, true, false)</expression>
    </formulas>
    <formulas>
        <name>FormulaForDefaultBoxOrderQty</name>
        <dataType>Number</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!storeRemainingQuantity})),
        {!storeRemainingQuantity} &gt; 0,
        {!NoOfPcsInOneBox} &gt; 0
    ),
    CEILING({!storeRemainingQuantity} / {!NoOfPcsInOneBox}),
    NULL
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>FormulaForDiscountName</name>
        <dataType>String</dataType>
        <expression>{!Get_Account.Customer_Disc_Group__c} &amp; &quot;_&quot; &amp; {!Get_Oriplast_Product_Details.Item_Disc_Group__c}</expression>
    </formulas>
    <formulas>
        <name>FormulaForDiscountName_E</name>
        <dataType>String</dataType>
        <expression>{!For_Each_Item_Of_Select.Ori_Plast_Order__r.Account__r.Customer_Disc_Group__c} &amp; &quot;_&quot; &amp; {!For_Each_Item_Of_Select.Ori_Plast_Product__r.Item_Disc_Group__c}</expression>
    </formulas>
    <formulas>
        <name>FormulaForFinalPriceAfterAllDiscount</name>
        <dataType>Currency</dataType>
        <expression>{!PriceAfterCD}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForFinalPriceAfterAllDiscountE</name>
        <dataType>Currency</dataType>
        <expression>{!PriceAfterCDE}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForIdentifier</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!SearchWithIdentifier.middleValue})), {!SearchWithIdentifier.middleValue},&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>FormulaForModValue</name>
        <dataType>Number</dataType>
        <expression>MOD({!Order_Quantity_For_Create},(VALUE({!Loop.Length__c})/100))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForOrderQuantityDisplay</name>
        <dataType>Number</dataType>
        <expression>IF({!Order_In_Boxes} = true, {!calculateQuantityForBoxOrder}, {!storeRemainingQuantity})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>FormulaForPartiallyDeliveredBoxCheck</name>
        <dataType>Boolean</dataType>
        <expression>{!storeRemainingQuantity} &gt; 0</expression>
    </formulas>
    <formulas>
        <name>FormulaForPriceAfterCD</name>
        <dataType>Currency</dataType>
        <expression>{!ProductPriceAfterTradeDiscount}-{!CashDiscount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForPriceAfterCDE</name>
        <dataType>Currency</dataType>
        <expression>{!ProductPriceAfterTradeDiscount}-{!CashDiscount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForProductCatagory</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!SearchWithSubcatagory.topValue})), {!SearchWithSubcatagory.topValue}, IF(NOT(ISBLANK({!SearchWithIdentifier.topValue})), {!SearchWithIdentifier.topValue},&apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>FormulaForProductDiscount</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Discount.Id})), ({!TotalOrderValue})-(({!TotalOrderValue})*({!TDAndSDDiscount}/100)), ({!TotalOrderValue}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForProductDiscount_E</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Discount_E.Id})), ({!TotalOrderValue_E})-(({!TotalOrderValue_E})*({!TDAndSDDiscount}/100)), ({!TotalOrderValue_E}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForProductDiscountAfterCD</name>
        <dataType>Currency</dataType>
        <expression>{!PriceAfterCD}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForProductDiscountAfterCD_E</name>
        <dataType>Currency</dataType>
        <expression>{!ProductPriceAfterTradeDiscount}*(4/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForProductSubCatagory</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!SearchWithSubcatagory.middleValue})), {!SearchWithSubcatagory.middleValue}, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>FormulaForQuantityValidation</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Quantity} &gt; 0, true, false)</expression>
    </formulas>
    <formulas>
        <name>FormulaForSGST</name>
        <dataType>Currency</dataType>
        <expression>{!TotalGST}/2</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForSGST_E</name>
        <dataType>Currency</dataType>
        <expression>{!TotalGST}/2</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForSpecialDiscount</name>
        <dataType>Number</dataType>
        <expression>IF({!PriceAfterCD}&gt;100000, (({!PriceAfterCD})*(4/100)), 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForSpecialDiscount_E</name>
        <dataType>Number</dataType>
        <expression>IF({!PriceAfterCDE}&gt;100000, (({!PriceAfterCDE})*(4/100)), 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForTDandSD</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Discount.Discount__c})), {!Get_Discount.Discount__c}, 0) + IF(NOT(ISBLANK({!Get_Discount.Special_Discount__c})), {!Get_Discount.Special_Discount__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForTotalGST</name>
        <dataType>Currency</dataType>
        <expression>{!FinalPriceAfterAllDiscount}*({!Get_Oriplast_Product_Details.GST_Value__c}/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForTotalGST_E</name>
        <dataType>Currency</dataType>
        <expression>{!FinalPriceAfterAllDiscount}*({!For_Each_Item_Of_Select.Ori_Plast_Product__r.GST_Value__c}/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForTradeDiscount</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Discount.Id})), (({!TotalOrderValue})*({!TDAndSDDiscount}/100)), 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForTradeDiscount_E</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Discount_E.Id})), (({!TotalOrderValue_E})*({!TDAndSDDiscount}/100)), 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TotalOrderdLengthInMeter</name>
        <dataType>String</dataType>
        <expression>TEXT(VALUE({!Loop.Length_In_Meter__c}) * {!Order_Quantity_For_Create})</expression>
    </formulas>
    <formulas>
        <name>TotalOrderdLengthInMeterEdit</name>
        <dataType>String</dataType>
        <expression>TEXT({!Quantity}*VALUE({!For_Each_Item_Of_Select.Ori_Plast_Product__r.Length_In_Meter__c}))</expression>
    </formulas>
    <formulas>
        <name>TotalOrderValue</name>
        <dataType>Currency</dataType>
        <expression>
IF(
    {!UOMForCreate} = &quot;MTR&quot;,
    {!Get_Product_Sales_Price.Unit_Price__c} * VALUE({!TotalOrderdLengthInMeter}),
    {!Get_Product_Sales_Price.Unit_Price__c} * {!Order_Quantity_For_Create}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TotalOrderValue_E</name>
        <dataType>Currency</dataType>
        <expression>
IF(
    {!UOMForEdit} = &quot;MTR&quot;,
    {!For_Each_Item_Of_Select.OriPlast_Product_Unit_Price__c} * VALUE({!TotalOrderdLengthInMeterEdit}),
    {!For_Each_Item_Of_Select.OriPlast_Product_Unit_Price__c} * {!Quantity}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TradeAndSpecialDiscountValueE</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Discount_E.Special_Discount__c})), {!Get_Discount_E.Special_Discount__c}, 0) + IF(NOT(ISBLANK({!Get_Discount_E.Discount__c})), {!Get_Discount_E.Discount__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>UOMFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Loop.Length_In_Meter__c} = &quot;0&quot; || {!Loop.Length_In_Meter__c} =&quot;&quot;
, &quot;PCS (Piece)&quot;, &quot;MTR (Meter)&quot;)</expression>
    </formulas>
    <formulas>
