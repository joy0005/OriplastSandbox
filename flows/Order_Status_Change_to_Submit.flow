    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_User_Ids_For_Send_Notification</name>
        <label>Assign User Ids For Send Notification</label>
        <locationX>490</locationX>
        <locationY>1214</locationY>
        <assignmentItems>
            <assignToReference>UserIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Add_Ids.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>store_line_items</name>
        <label>store line items</label>
        <locationX>292</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>storelineItems</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Order_Line_Items</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Outstanding_Order_Value</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_If_there_Is_any_line_items</name>
        <label>Check If there Is any line items</label>
        <locationX>534</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Display_Message_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Line_Items_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order_Line_Items</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Order_Status</targetReference>
            </connector>
            <label>If Line Items Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Outstanding_Order_Value</name>
        <label>Check Outstanding Order Value</label>
        <locationX>292</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Check_If_there_Is_any_line_items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Getter_than_30_lakh</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order_Details_to_send_Notification.Account__r.Total_Outstanding_Order_Value__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Order_Details_to_send_Notification.Account__r.Current_Limit__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Finish</targetReference>
            </connector>
            <label>If Getter than Current Limit</label>
        </rules>
    </decisions>
    <description>remove hardcode 30 lakh from decision.</description>
    <environments>Default</environments>
    <interviewLabel>Order Status Change to Submit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Status Change to Submit</label>
    <loops>
        <name>Add_Ids</name>
        <label>Add Ids</label>
        <locationX>402</locationX>
        <locationY>1106</locationY>
        <collectionReference>Get_Specific_UserId</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_User_Ids_For_Send_Notification</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Send_Notification</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
