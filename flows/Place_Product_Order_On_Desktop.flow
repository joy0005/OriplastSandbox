            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TotalGivenOrderValueAfterDiscount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1500000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Error</targetReference>
            </connector>
            <label>Order Value More Than 1500000</label>
        </rules>
        <rules>
            <name>Check_Outstanding_Order_Value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OutstandingAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>6000000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Finish_0_0_0_0</targetReference>
            </connector>
            <label>Check Outstanding Order Value</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Total_Value_Is_Getter_than_60_laks</name>
        <label>Check Total Value Is Getter than 60 laks</label>
        <locationX>1165</locationX>
