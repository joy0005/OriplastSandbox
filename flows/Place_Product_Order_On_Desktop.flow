    <environments>Default</environments>
    <formulas>
        <name>CalculateGST</name>
        <dataType>Currency</dataType>
        <expression>{!FinalPriceAfterAllDiscount}+({!FinalPriceAfterAllDiscount}*({!Loop.GST_Value__c}/100))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForCashDiscount</name>
        <dataType>Currency</dataType>
        <expression>{!ProductPriceAfterTradeDiscount}*(4/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForCGST</name>
        <dataType>Currency</dataType>
        <expression>{!TotalGST}/2</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForDiscountName</name>
        <dataType>String</dataType>
        <expression>{!Get_Account_for_Discount.Customer_Disc_Group__c}&amp; &quot;_&quot; &amp; {!Get_Oriplast_Product_Details.Item_Disc_Group__c}</expression>
    </formulas>
    <formulas>
        <name>FormulaForDistributorID</name>
        <dataType>String</dataType>
        <expression>IF({!SalesProfile}=True, {!Select_Distributor.selectedChoiceValues}, {!Select_Account.selectedChoiceValues})</expression>
    </formulas>
    <formulas>
        <name>FormulaForFinalPriceAfterAllDiscount</name>
        <dataType>Currency</dataType>
        <expression>{!PriceAfterCD}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForIdentifier</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!SearchWithIdentifier.middleValue})), {!SearchWithIdentifier.middleValue},&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>FormulaForOrderQuantity</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Order_Quantity} &gt; 0, true, false)</expression>
    </formulas>
    <formulas>
        <name>FormulaForPriceAfterCD</name>
        <dataType>Currency</dataType>
        <expression>{!ProductPriceAfterTradeDiscount}-{!CashDiscount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForProductCatagory</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!SearchWithSubcatagory.topValue})), {!SearchWithSubcatagory.topValue}, IF(NOT(ISBLANK({!SearchWithIdentifier.topValue})), {!SearchWithIdentifier.topValue},&apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>FormulaForProductDiscount</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!GetDiscount.Id})), ({!TotalOrderValue})-(({!TotalOrderValue})*({!TradeAndSpecialDiscountValue}/100)), ({!TotalOrderValue}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForProductDiscountAfterCD</name>
        <dataType>Currency</dataType>
        <expression>
({!TotalOrderValue}-({!TradeDiscount} + {!SpecialDiscount} +({!TotalOrderValue}*(4/100))))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForProductSubCatagory</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!SearchWithSubcatagory.middleValue})), {!SearchWithSubcatagory.middleValue}, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>FormulaForSGST</name>
        <dataType>Currency</dataType>
        <expression>{!TotalGST}/2</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForSpecialDiscount</name>
        <dataType>Number</dataType>
        <expression>IF({!PriceAfterCD}&gt;100000, (({!PriceAfterCD})*(4/100)), 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForTDAndSD</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!GetDiscount.Discount__c})), {!GetDiscount.Discount__c}, 0) + IF(NOT(ISBLANK({!GetDiscount.Special_Discount__c})), {!GetDiscount.Special_Discount__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForTotalGST</name>
        <dataType>Currency</dataType>
        <expression>{!FinalPriceAfterAllDiscount}*({!Get_Oriplast_Product_Details.GST_Value__c}/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaForTradeDiscount</name>
        <dataType>Currency</dataType>
        <expression>
IF(NOT(ISBLANK({!GetDiscount.Id})), (({!TotalOrderValue})*({!TradeAndSpecialDiscountValue}/100)), 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>SalesProfile</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Profile.Name}=&apos;Sales&apos;, True, False)</expression>
    </formulas>
    <formulas>
        <name>StoreAccountIdForCheckingOutstandingAmount</name>
        <dataType>Number</dataType>
        <expression>2</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TotalOrderdLengthInMeter</name>
        <dataType>String</dataType>
        <expression>TEXT(VALUE({!Loop.Length_In_Meter__c}) * {!Order_Quantity})</expression>
    </formulas>
    <formulas>
        <name>TotalOrderValue</name>
        <dataType>Currency</dataType>
        <expression>
IF(
    {!UOM} = &quot;MTR&quot;,
    {!Get_Product_Sales_Price.Unit_Price__c} * VALUE({!TotalOrderdLengthInMeter}),
    {!Get_Product_Sales_Price.Unit_Price__c} * {!Order_Quantity}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>UOMFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Loop.Length_In_Meter__c} = &quot;0&quot; || {!Loop.Length_In_Meter__c}=&quot;&quot;
, &quot;PCS (Piece)&quot;, &quot;MTR (Meter)&quot;)</expression>
    </formulas>
