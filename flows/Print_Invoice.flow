    <recordLookups>
        <name>Get_All_Order_Line_Item</name>
        <label>Get All Order Line Item</label>
        <locationX>172</locationX>
        <locationY>230</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Order_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Ori_Plast_Order__c</field>
            <operator>EqualTo</operator>
            <value>
