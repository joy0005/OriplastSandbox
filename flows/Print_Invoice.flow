    <decisions>
        <name>Check_Account_Is_Blank_Or_not</name>
        <label>Check Account Is Blank Or not</label>
        <locationX>475</locationX>
        <locationY>371</locationY>
        <defaultConnector>
            <targetReference>Check_Whether_all_oli_has_Product_Price</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order_Details.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_0</targetReference>
            </connector>
            <label>If Blank</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Product_Price</name>
        <label>Check Product Price</label>
        <locationX>474</locationX>
        <locationY>497</locationY>
        <defaultConnector>
            <targetReference>Store_Product_Name</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Whether_all_oli_has_Product_Price.OriPlast_Product_Unit_Price__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Whether_all_oli_has_Product_Price</targetReference>
            </connector>
            <label>If Present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Print Invoice {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Print Invoice</label>
    <loops>
        <name>Check_Whether_all_oli_has_Product_Price</name>
        <label>Check Whether all oli has Product Price</label>
        <locationX>185</locationX>
        <locationY>497</locationY>
        <collectionReference>Get_All_Order_Line_Item</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
