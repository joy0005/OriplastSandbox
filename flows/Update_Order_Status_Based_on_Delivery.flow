<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_The_Current_Order_Line_Item_Status</name>
        <label>Check The Current Order Line Item Status</label>
        <locationX>759</locationX>
        <locationY>525</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Partially_Delivered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partially Delivered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Order_Status_to_Partially_Delivered</targetReference>
            </connector>
            <label>If Partially Delivered</label>
        </rules>
        <rules>
            <name>If_All_Delivered</name>
            <conditionLogic>(1 OR 3 OR 4) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delivered</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_All_Related_Order_Line_Items_Records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Short Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Order_Status_to_Delivered</targetReference>
            </connector>
            <label>If All Delivered</label>
        </rules>
        <rules>
            <name>If_Not_All_Delivered</name>
            <conditionLogic>(1 OR 3 OR 4) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delivered</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_All_Related_Order_Line_Items_Records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Short Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Order_Status_to_Partially_Delivered</targetReference>
            </connector>
            <label>If Not All Delivered</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Update Order Status Based on Delivery {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Order Status Based on Delivery</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Related_Order_Line_Items_Records</name>
        <label>Get All Related Order Line Items Records</label>
        <locationX>540</locationX>
        <locationY>399</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_The_Current_Order_Line_Item_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Ori_Plast_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Ori_Plast_Order__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Delivered</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Short Closed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Order_Line_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Order_Status_to_Delivered</name>
        <label>Update Order Status to Delivered</label>
        <locationX>1020</locationX>
        <locationY>602</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Ori_Plast_Order__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Order_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Delivered</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Order_Status__c</field>
            <value>
                <stringValue>Delivered</stringValue>
            </value>
        </inputAssignments>
        <object>Ori_Plast_Order__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Order_Status_to_Partially_Delivered</name>
        <label>Update Order Status to Partially Delivered</label>
        <locationX>419</locationX>
        <locationY>612</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Ori_Plast_Order__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Order_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Partially Delivered</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Order_Status__c</field>
            <value>
                <stringValue>Partially Delivered</stringValue>
            </value>
        </inputAssignments>
        <object>Ori_Plast_Order__c</object>
    </recordUpdates>
    <start>
        <locationX>411</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Get_All_Related_Order_Line_Items_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Order_Line_Item__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
