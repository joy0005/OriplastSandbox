        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Order_Status</name>
        <label>Update Order Status</label>
        <locationX>565</locationX>
        <locationY>486</locationY>
        <inputAssignments>
            <field>Order_Status__c</field>
            <value>
                <stringValue>Received by Navision</stringValue>
