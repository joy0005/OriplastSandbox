    <fields>
        <fullName>Final_Invoice_Value__c</fullName>
        <label>Final Invoice Value</label>
        <summarizedField>Invoice_Line_Item__c.Final_Price__c</summarizedField>
        <summaryForeignKey>Invoice_Line_Item__c.Ori_Plast_Invoice__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Invoice_Date_Formatted__c</fullName>
        <formula>IF(LEN(Invoice_Date__c) == 9,
DATE(
VALUE(&apos;20&apos;+RIGHT( Invoice_Date__c , 2)),
CASE(MID(Invoice_Date__c, 4 , 3),
&quot;Jan&quot;,01,
&quot;Feb&quot;,02,
&quot;Mar&quot;,03,
&quot;Apr&quot;,04,
&quot;May&quot;,05,
&quot;Jun&quot;,06,
&quot;Jul&quot;,07,
&quot;Aug&quot;,08,
&quot;Sep&quot;,09,
&quot;Oct&quot;,10,
&quot;Nov&quot;,11,
12
),
VALUE(LEFT(Invoice_Date__c, 2))
),
DATE(
VALUE(&apos;20&apos;+RIGHT( Invoice_Date__c , 2)),
CASE(MID(Invoice_Date__c, 3 , 3),
&quot;Jan&quot;,01,
&quot;Feb&quot;,02,
&quot;Mar&quot;,03,
&quot;Apr&quot;,04,
&quot;May&quot;,05,
&quot;Jun&quot;,06,
&quot;Jul&quot;,07,
&quot;Aug&quot;,08,
&quot;Sep&quot;,09,
&quot;Oct&quot;,10,
&quot;Nov&quot;,11,
12
),
VALUE(LEFT(Invoice_Date__c, 1))
)
)</formula>
        <label>Invoice Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Invoice_Date__c</fullName>
        <externalId>false</externalId>
        <label>Invoice Date Text</label>
        <length>255</length>
        <required>false</required>
