    <fields>
        <fullName>Remaining_Price_For_Shipment__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
        OR(
            ISPICKVAL(Status__c, &quot;Partially Delivered&quot;),
            ISPICKVAL(Status__c, &quot;Received by Business Central&quot;),
            ISBLANK(TEXT(Status__c))
        ),
        Final_Price__c - Final_Price_After_Shipment__c,
        0
    )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Remaining Shipment Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Remaining_Quantity__c</fullName>
        <externalId>false</externalId>
        <formula>ERP_Quantity__c -  Shipped_Quantity__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Remaining Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
