    <fields>
        <fullName>OriPlast_Product_Price__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>OriPlast Product Price</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Product_Price__c.Oriplast_Product__c</field>
                <operation>equals</operation>
                <valueField>$Source.Ori_Plast_Product__c</valueField>
            </filterItems>
            <infoMessage>Please select a price belongs to the selected product.</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Product_Price__c</referenceTo>
        <relationshipLabel>Order-Line-Items</relationshipLabel>
        <relationshipName>Order_Line_Items</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
