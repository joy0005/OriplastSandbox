    <fields>
        <fullName>Category__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(Ori_Plast_Product__r.Category_Picklist__c,
&apos;P1&apos;,&apos;PVC Pipe ASTM-D-1785, PVC ASTM (Schdule)&apos;,
&apos;P2&apos;,&apos;PVC Grey pipes as per IS : 4985,UPVC IS 4985&apos;,
&apos;P3&apos;,&apos;CASING &amp; PVC Casing Pipes as per IS : 12818&apos;,
&apos;P4&apos;,&apos;PVC SCREEN &amp; PVC Screen Pipes as per IS : 12818&apos;,
&apos;P5&apos;,&apos;PVC GARDEN HOSE PIPE&apos;,
&apos;P6&apos;,&apos;PVC SWR pipes &amp; fittings as per IS:13592&apos;,
&apos;P7&apos;,&apos;PVC Column Pipe&apos;,
&apos;P8&apos;,&apos;PVC Submersible&apos;,
&apos;P9&apos;,&apos;CPVC Pipe&apos;,
&apos;PF&apos;,&apos;PVC Fittings&apos;,
&apos;H1&apos;,&apos;HDPE Pipe IS 4984 (Black)&apos;,
&apos;H2&apos;,&apos;HDPE Pipe IS 14333 (Black)&apos;,
&apos;H3&apos;,&apos;GI STANDERD &amp; PLB Duct Pipe&apos;,
&apos;H4&apos;,&apos;HDPE IS 4427 (Blue/Black)&apos;,
&apos;H5&apos;,&apos;HDPE 4984-2016&apos;,
&apos;HF&apos;,&apos;HDPE Fittings&apos;,
&apos;DF&apos;,&apos;Direct Action Hand Pump Fittings&apos;,
&apos;M1&apos;,&apos;MDPE Pipe &amp; MDPE IS 14885&apos;,
&apos;M2&apos;,&apos;MDPE pipe &amp; MDPE IS 4427&apos;,
&apos;SL&apos;,&apos;Solvent Cement&apos;,
&apos;NI&apos;,&apos;PVC SWR pipes &amp; fittings (non-standard)&apos;,
&apos;DP&apos;,&apos;Direct Action Hand Pump Set&apos;,
&apos;H6&apos;,&apos;PPR&apos;,
&apos;H7&apos;,&apos;HDPE Copper Wire&apos;,
&apos;M3&apos;,&apos;PE PIPE(MDPE)&apos;,
&apos;MF&apos;,&apos;MDPE Fittings&apos;,
&apos;OF&apos;,&apos;OPVC Fittings&apos;,
&apos;OP&apos;,&apos;OPVC Pipe&apos;,
&apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Category</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ERP_Quantity__c</fullName>
        <externalId>false</externalId>
        <formula>IF( CONTAINS(Unit_of_Measure__c, &apos;MTR&apos;) ,(Quantity__c * VALUE(Ori_Plast_Product__r.Length_In_Meter__c)), Quantity__c)</formula>
        <label>ERP Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
