    <fields>
        <fullName>Inactive_Product__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Inactive Product</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Inventory_Posting_Group__c</fullName>
        <description>This field is used for where in the inventory accounts in the balance,items should be posted,when receiving and selling the items.</description>
        <externalId>false</externalId>
        <inlineHelpText>It is used for entering Inventory Posting Group.</inlineHelpText>
        <label>Inventory Posting Group</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Item_Disc_Group__c</fullName>
        <description>Here the discounts are defined for specific items or item groups.</description>
        <externalId>false</externalId>
        <inlineHelpText>It is used for entering Item Discount Group</inlineHelpText>
        <label>Item Disc. Group</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Length_In_Meter__c</fullName>
        <description>This field will display the length of the product in meter</description>
        <externalId>false</externalId>
        <formula>TEXT(VALUE(Length__c)/10)</formula>
        <label>Length (Meter)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Length__c</fullName>
        <externalId>false</externalId>
        <label>Length</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Nature__c</fullName>
        <externalId>false</externalId>
        <label>Nature</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>No_of_Pcs_in_one_box__c</fullName>
        <externalId>false</externalId>
        <label>No of Pcs in one box</label>
        <precision>18</precision>
        <required>false</required>
