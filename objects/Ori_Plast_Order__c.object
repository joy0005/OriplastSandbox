    <fields>
        <fullName>Account__c</fullName>
        <description>Ori-plast product Supplier</description>
        <inlineHelpText>The distributor account that generated the sales order.</inlineHelpText>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Ori-Plast Orders</relationshipLabel>
        <relationshipName>Ori_Plast_Orders</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Current_Limit__c</fullName>
        <externalId>false</externalId>
        <label>Current Limit</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_of_created__c</fullName>
        <externalId>false</externalId>
        <formula>TODAY() -   DATEVALUE(CreatedDate)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days of created</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Final_Order_Value__c</fullName>
        <description>This field store Final Price(Price after discount+cgst+sgst)</description>
        <inlineHelpText>Calculated price of all submitted line items.</inlineHelpText>
        <label>Total Order Value</label>
        <summarizedField>Order_Line_Item__c.Final_Price__c</summarizedField>
        <summaryForeignKey>Order_Line_Item__c.Ori_Plast_Order__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Order_No__c</fullName>
        <displayFormat>ON-26-27-{000000}</displayFormat>
        <externalId>false</externalId>
        <label>Order No</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>AutoNumber</type>
    </fields>
    <fields>
        <fullName>Order_Status__c</fullName>
        <description>This field state different stage of orders</description>
        <inlineHelpText>Order Status indicates various order stages.</inlineHelpText>
        <label>Order Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Draft</fullName>
                    <color>#FF9900</color>
                    <default>true</default>
                    <label>Draft</label>
                </value>
                <value>
                    <fullName>Submitted</fullName>
                    <color>#33FFFF</color>
                    <default>false</default>
                    <label>Submitted</label>
                </value>
                <value>
                    <fullName>Received by Navision</fullName>
                    <color>#66FF99</color>
                    <default>false</default>
                    <label>Received by Business Central</label>
                </value>
                <value>
                    <fullName>Partially Delivered</fullName>
                    <color>#66CCCC</color>
                    <default>false</default>
                    <label>Partially Delivered</label>
                </value>
                <value>
                    <fullName>Delivered</fullName>
                    <color>#33CC00</color>
                    <default>false</default>
                    <label>Delivered</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Outstanding_Order_Value__c</fullName>
        <description>Sum of all Order values which are either not delivered or cancelled.</description>
        <inlineHelpText>Calculated price for not delivered or cancelled line items.</inlineHelpText>
        <label>Outstanding Order Value</label>
        <summarizedField>Order_Line_Item__c.Final_Price__c</summarizedField>
        <summaryFilterItems>
            <field>Order_Line_Item__c.Status__c</field>
            <operation>notEqual</operation>
            <value>Delivered, Cancelled</value>
        </summaryFilterItems>
        <summaryForeignKey>Order_Line_Item__c.Ori_Plast_Order__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Remaining_Total_Order_Item_Value__c</fullName>
        <label>Total Order Pending Value</label>
        <summarizedField>Order_Line_Item__c.Remaining_Price_For_Shipment__c</summarizedField>
        <summaryFilterItems>
            <field>Order_Line_Item__c.Status__c</field>
            <operation>notContain</operation>
            <value>Delivered, Cancelled, Short Closed</value>
        </summaryFilterItems>
        <summaryForeignKey>Order_Line_Item__c.Ori_Plast_Order__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Short_Close_Reason__c</fullName>
        <externalId>false</externalId>
